+package hy2
+
+import (
+	"go.uber.org/zap"
+	"net"
+	"sync"
+	"time"
+)
+
+// Experimental observation only. Bound memory and emitted log growth globally
+// per core; never retain credentials, account IDs, node URLs or peer maps.
+// One record per rejected Authenticate call, not per packet or QUIC stream.
+// A malicious connection can submit multiple auth requests; each is an attempt.
+type authRejectLogger struct {
+	mutex   sync.Mutex
+	logger  *zap.Logger
+	window  time.Time
+	emitted uint32
+	dropped uint64
+}
+
+func (l *authRejectLogger) reject(addr net.Addr) {
+	if l == nil || l.logger == nil {
+		return
+	}
+	peer, ok := addr.(*net.UDPAddr)
+	if !ok || peer == nil || peer.IP.To16() == nil || peer.IP.IsUnspecified() || peer.IP.IsMulticast() || peer.Port < 1 || peer.Port > 65535 || peer.Zone != "" {
+		return
+	}
+	// Numeric typed address only: never format arbitrary caller-provided strings.
+	endpoint := (&net.UDPAddr{IP: peer.IP, Port: peer.Port}).String()
+	l.mutex.Lock()
+	defer l.mutex.Unlock()
+	now := time.Now()
+	if l.window.IsZero() || now.Sub(l.window) >= time.Second {
+		if l.dropped > 0 {
+			l.logger.Error("v2bx authentication observations dropped", zap.Int("schema_version", 1), zap.String("core", "hysteria2"), zap.String("protocol", "hysteria2"), zap.Uint64("dropped", l.dropped))
+		}
+		l.window = now
+		l.emitted = 0
+		l.dropped = 0
+	}
+	// At most 20 rejection records plus one drop summary in a fixed window.
+	// Summary is emitted on the next attempt; shutdown may leave pending drops.
+	if l.emitted >= 20 {
+		l.dropped++
+		return
+	}
+	l.emitted++
+	l.logger.Error("v2bx authentication rejected", zap.Int("schema_version", 1), zap.String("core", "hysteria2"), zap.String("protocol", "hysteria2"), zap.String("event_type", "auth_rejected"), zap.String("addr", endpoint))
+}
