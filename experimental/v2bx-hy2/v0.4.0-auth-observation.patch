+package hy2
+
+import (
+	"go.uber.org/zap"
+	"go.uber.org/zap/zaptest/observer"
+	"net"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestAuthObservationPrivacyAndCompatibility(t *testing.T) {
+	core, logs := observer.New(zap.ErrorLevel)
+	v := &V2bX{usersMap: map[string]int{"valid-secret": 1}}
+	// Construct through the production New wiring, then replace only the sink.
+	runtime, err := New(testCoreConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := runtime.(*Hysteria2)
+	h.Auth.usersMap = v.usersMap
+	h.Auth.rejections.logger = zap.New(core)
+	good := &net.UDPAddr{IP: net.ParseIP("198.51.100.7"), Port: 12345}
+	if ok, id := h.Auth.Authenticate(good, "valid-secret", 0); !ok || id != "valid-secret" {
+		t.Fatal("changed valid auth")
+	}
+	if logs.Len() != 0 {
+		t.Fatal("valid auth logged rejection")
+	}
+	for _, addr := range []net.Addr{good, &net.UDPAddr{IP: net.ParseIP("2001:db8::7"), Port: 12345}} {
+		if ok, id := h.Auth.Authenticate(addr, "submitted-secret", 999); ok || id != "" {
+			t.Fatal("changed invalid auth")
+		}
+	}
+	if logs.Len() != 2 {
+		t.Fatalf("want 2, got %d", logs.Len())
+	}
+	for i, e := range logs.All() {
+		want := "198.51.100.7:12345"
+		if i == 1 {
+			want = "[2001:db8::7]:12345"
+		}
+		fields := e.ContextMap()
+		if e.Message != "v2bx authentication rejected" || len(fields) != 5 || fields["schema_version"] != int64(1) || fields["core"] != "hysteria2" || fields["protocol"] != "hysteria2" || fields["event_type"] != "auth_rejected" || fields["addr"] != want {
+			t.Fatalf("unexpected fixed fields: %#v", e)
+		}
+	}
+	for _, addr := range []net.Addr{nil, &net.UDPAddr{}, &net.UDPAddr{IP: net.ParseIP("224.0.0.1"), Port: 12}, &net.UDPAddr{IP: net.ParseIP("198.51.100.7"), Port: 65536}, &net.UDPAddr{IP: net.ParseIP("fe80::1"), Port: 12, Zone: "private-device"}} {
+		h.Auth.Authenticate(addr, "submitted-secret", 0)
+	}
+	if logs.Len() != 2 {
+		t.Fatal("unsafe endpoint logged")
+	}
+}
+
+func TestAuthObservationBoundedConcurrentGrowth(t *testing.T) {
+	core, logs := observer.New(zap.ErrorLevel)
+	now := time.Now()
+	sink := &authRejectLogger{logger: zap.New(core), window: now}
+	v := &V2bX{usersMap: map[string]int{}, rejections: sink}
+	var wg sync.WaitGroup
+	for i := 0; i < 100; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			v.Authenticate(&net.UDPAddr{IP: net.ParseIP("198.51.100.8"), Port: 4567}, "bad", 0)
+		}()
+	}
+	wg.Wait()
+	if logs.Len() != 20 || sink.dropped != 80 {
+		t.Fatalf("unbounded: logs=%d drops=%d", logs.Len(), sink.dropped)
+	}
+	sink.window = time.Now().Add(-2 * time.Second)
+	v.Authenticate(&net.UDPAddr{IP: net.ParseIP("198.51.100.8"), Port: 4567}, "bad", 0)
+	if logs.Len() != 22 {
+		t.Fatal("missing next-window drop summary / rejection")
+	}
+	summary := logs.All()[20]
+	if summary.Message != "v2bx authentication observations dropped" || len(summary.ContextMap()) != 4 || summary.ContextMap()["dropped"] != uint64(80) {
+		t.Fatal("invalid drop summary")
+	}
+}
