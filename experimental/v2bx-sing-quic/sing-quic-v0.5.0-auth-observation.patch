+		s.closeWithError(err)
+	}
+	if len(c.lines) != 1 || !strings.Contains(c.lines[0], `"event_type":"auth_rejected"`) {
+		t.Fatalf("duplicate/unstructured logs: %#v", c.lines)
+	}
+}
