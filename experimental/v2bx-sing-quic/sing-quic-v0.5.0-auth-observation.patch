+// Package observation emits fixed, bounded, experimental authentication events.
+package observation
+
+import (
+	"encoding/json"
+	"errors"
+	"github.com/sagernet/sing/common/logger"
+	"net"
+	"sync"
+	"time"
+)
+
+// ErrRejected carries no account or submitted credential. Callers suppress
+// duplicate generic error logging for this sentinel, including wrapped errors.
+var ErrRejected = errors.New("authentication rejected")
+
+type Sink struct {
+	mu       sync.Mutex
+	logger   logger.Logger
+	protocol string
+	window   time.Time
+	emitted  uint32
+	dropped  uint64
+}
+
+func New(log logger.Logger, protocol string) *Sink {
+	switch protocol {
+	case "tuic", "hysteria", "hysteria2":
+		return &Sink{logger: log, protocol: protocol}
+	}
+	return nil
+}
+func (s *Sink) Reject(addr net.Addr) {
+	if s == nil || s.logger == nil {
+		return
+	}
+	peer, ok := addr.(*net.UDPAddr)
+	if !ok || peer == nil || peer.IP.To16() == nil || peer.IP.IsUnspecified() || peer.IP.IsMulticast() || peer.Port < 1 || peer.Port > 65535 || peer.Zone != "" {
+		return
+	}
+	endpoint := (&net.UDPAddr{IP: peer.IP, Port: peer.Port}).String()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	now := time.Now()
+	if s.window.IsZero() || now.Sub(s.window) >= time.Second {
+		if s.dropped > 0 {
+			data, _ := json.Marshal(struct {
+				SchemaVersion int    `json:"schema_version"`
+				Core          string `json:"core"`
+				Protocol      string `json:"protocol"`
+				EventType     string `json:"event_type"`
+				Dropped       uint64 `json:"dropped"`
+			}{1, "sing", s.protocol, "observations_dropped", s.dropped})
+			s.logger.Error("v2bx-observation ", string(data))
+		}
+		s.window = now
+		s.emitted = 0
+		s.dropped = 0
+	}
+	// Per service fixed one-second window, not a sliding-second connection limit.
+	// Drop summaries need a later attempt; shutdown can leave pending counts.
+	if s.emitted >= 20 {
+		s.dropped++
+		return
+	}
+	s.emitted++
+	data, _ := json.Marshal(struct {
+		SchemaVersion int    `json:"schema_version"`
+		Core          string `json:"core"`
+		Protocol      string `json:"protocol"`
+		EventType     string `json:"event_type"`
+		Addr          string `json:"addr"`
+	}{1, "sing", s.protocol, "auth_rejected", endpoint})
+	s.logger.Error("v2bx-observation ", string(data))
+}
