+package observation
+
+import (
+	"encoding/json"
+	"fmt"
+	"github.com/sagernet/sing/common/logger"
+	"net"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+type capture struct {
+	logger.Logger
+	mu    sync.Mutex
+	lines []string
+}
+
+func (c *capture) Error(args ...any) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.lines = append(c.lines, fmt.Sprint(args...))
+}
+func TestFixedPrivateFields(t *testing.T) {
+	c := &capture{}
+	s := New(c, "hysteria")
+	s.Reject(&net.UDPAddr{IP: net.ParseIP("2001:db8::7"), Port: 12345})
+	if len(c.lines) != 1 {
+		t.Fatal("no rejection")
+	}
+	var fields map[string]any
+	if !strings.HasPrefix(c.lines[0], "v2bx-observation ") || json.Unmarshal([]byte(strings.TrimPrefix(c.lines[0], "v2bx-observation ")), &fields) != nil {
+		t.Fatal("invalid contract")
+	}
+	if len(fields) != 5 || fields["schema_version"] != float64(1) || fields["core"] != "sing" || fields["protocol"] != "hysteria" || fields["event_type"] != "auth_rejected" || fields["addr"] != "[2001:db8::7]:12345" {
+		t.Fatalf("unsafe fields: %#v", fields)
+	}
+	for _, addr := range []net.Addr{nil, &net.UDPAddr{}, &net.UDPAddr{IP: net.ParseIP("224.0.0.1"), Port: 12}, &net.UDPAddr{IP: net.ParseIP("198.51.100.7"), Port: 65536}, &net.UDPAddr{IP: net.ParseIP("fe80::1"), Port: 12, Zone: "private-device"}} {
+		s.Reject(addr)
+	}
+	New(c, "unsupported").Reject(&net.UDPAddr{IP: net.ParseIP("198.51.100.7"), Port: 12})
+	if len(c.lines) != 1 {
+		t.Fatal("unsafe endpoint or protocol accepted")
+	}
+}
+func TestConcurrentBoundedLogsAndDeferredDrops(t *testing.T) {
+	c := &capture{}
+	s := New(c, "tuic")
+	s.window = time.Now()
+	var wg sync.WaitGroup
+	for i := 0; i < 100; i++ {
+		wg.Add(1)
+		go func() { defer wg.Done(); s.Reject(&net.UDPAddr{IP: net.ParseIP("198.51.100.8"), Port: 1234}) }()
+	}
+	wg.Wait()
+	if len(c.lines) != 20 || s.dropped != 80 {
+		t.Fatalf("logs=%d drops=%d", len(c.lines), s.dropped)
+	}
+	s.window = time.Now().Add(-2 * time.Second)
+	s.Reject(&net.UDPAddr{IP: net.ParseIP("198.51.100.8"), Port: 1234})
+	if len(c.lines) != 22 || !strings.Contains(c.lines[20], `"dropped":80`) || strings.Contains(c.lines[20], `"addr"`) {
+		t.Fatal("missing safe drop summary")
+	}
+}
