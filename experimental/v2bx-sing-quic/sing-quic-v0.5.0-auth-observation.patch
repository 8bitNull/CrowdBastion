+func TestUnknownUserRejectsOnceAndScrubsDuplicateErrors(t *testing.T) {
+	c := &captureAuth{}
+	s := &serverSession[int]{Service: &Service[int]{logger: c, userMap: map[[16]byte]int{}, observations: observation.New(c, "tuic")}, quicConn: authConn{}, connDone: make(chan struct{}), authDone: make(chan struct{})}
+	request := make([]byte, AuthenticateLen)
+	request[0] = Version
+	request[1] = CommandAuthenticate
+	for i := 2; i < 18; i++ {
+		request[i] = 0xab
+	}
+	for i := 0; i < 2; i++ {
+		err := s.handleUniStream(authStream{Reader: bytes.NewReader(request)})
+		if err == nil || strings.Contains(err.Error(), "abab") {
