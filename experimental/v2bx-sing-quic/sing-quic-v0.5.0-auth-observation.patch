+
+type control struct {
+	quic.Stream
+	input  *bytes.Reader
+	output bytes.Buffer
+}
+
+func (c *control) Read(p []byte) (int, error)  { return c.input.Read(p) }
+func (c *control) Write(p []byte) (int, error) { return c.output.Write(p) }
+
+type peerConnection struct {
+	quic.Connection
+	stream    *control
+	closeCode quic.ApplicationErrorCode
+}
+
+func (c *peerConnection) RemoteAddr() net.Addr {
+	return &net.UDPAddr{IP: net.ParseIP("198.51.100.11"), Port: 1234}
+}
+func (c *peerConnection) AcceptStream(context.Context) (quic.Stream, error) { return c.stream, nil }
+func (c *peerConnection) CloseWithError(code quic.ApplicationErrorCode, _ string) error {
+	c.closeCode = code
+	return nil
+}
+func TestWrongPasswordKeepsWireRejectionAndRemovesCredential(t *testing.T) {
+	var input bytes.Buffer
+	WriteClientHello(&input, ClientHello{SendBPS: 100, RecvBPS: 100, Auth: "submitted-private-password"})
+	conn := &peerConnection{stream: &control{input: bytes.NewReader(input.Bytes())}}
+	c := &authCapture{}
+	s := &serverSession[int]{Service: &Service[int]{logger: c, userMap: map[string]int{}, observations: observation.New(c, "hysteria")}, ctx: context.Background(), quicConn: conn, connDone: make(chan struct{})}
+	s.handleConnection()
+	hello, err := ReadServerHello(&conn.stream.output)
+	if err != nil || hello.OK || hello.Message != "Wrong password" || conn.closeCode != ErrorCodeAuthError {
+		t.Fatal("wire rejection changed")
+	}
+	if len(c.lines) != 1 || !strings.Contains(c.lines[0], `"event_type":"auth_rejected"`) || strings.Contains(c.lines[0], "submitted-private-password") {
+		t.Fatalf("unsafe rejection logs: %#v", c.lines)
+	}
+}
