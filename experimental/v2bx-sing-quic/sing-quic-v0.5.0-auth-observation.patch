+func TestRejectionIsDistinctFromMasqueradeAndBandwidthPolicy(t *testing.T) {
+	c := &authCapture{}
+	service := &Service[int]{logger: c, userMap: map[string]int{"valid": 1}, receiveBPS: 100, ignoreClientBandwidth: true, masqueradeHandler: http.NotFoundHandler(), observations: observation.New(c, "hysteria2")}
+	// Host/path/method are protocol fields. Arbitrary 404s must stay unclassified.
+	for _, mode := range []string{"ordinary", "bad", "policy"} {
+		s := &serverSession[int]{Service: service, quicConn: peerConnection{}}
+		r := httptest.NewRequest("GET", "https://ordinary.invalid/", nil)
+		if mode != "ordinary" {
+			r.Method = "POST"
+			r.Host = "hysteria"
+			r.URL.Path = "/auth"
+			r.Header.Set("Hysteria-Auth", "bad-secret")
+			r.Header.Set("Hysteria-CC-RX", "0")
+		}
+		if mode == "policy" {
+			r.Header.Set("Hysteria-Auth", "valid")
+		}
+		w := httptest.NewRecorder()
+		s.ServeHTTP(w, r)
+		if w.Code != 404 {
+			t.Fatal("response changed")
+		}
+	}
+	if len(c.lines) != 1 || !strings.Contains(c.lines[0], `"auth_rejected"`) || strings.Contains(c.lines[0], "bad-secret") {
+		t.Fatalf("wrong branch/leak: %#v", c.lines)
+	}
+}
