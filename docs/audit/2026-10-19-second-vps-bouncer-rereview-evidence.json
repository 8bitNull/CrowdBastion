    "/etc/crowdsec/scenarios/local-aomway-shop-filter-crawl.yaml": "type: leaky\nname: local/aomway-shop-filter-crawl\ndescription: Detect robots enumerating aomway shop filter combinations\nfilter: >-\n  evt.Meta.log_type == 'http_access-log' &&\n  evt.Meta.datasource_path == '/opt/1panel/www/sites/site-A/log/access.log' &&\n  evt.Meta.http_verb in ['GET', 'HEAD'] &&\n  (evt.Meta.http_path startsWith '/shop?' || evt.Meta.http_path startsWith '/shop/?') &&\n  evt.Meta.http_path contains 'products-' &&\n  evt.Meta.http_user_agent matches '(?i)(bot|crawler|spider)'\n# Keep the full query string; the standard parser strips it from file_name.\ndistinct: evt.Meta.http_path\ngroupby: evt.Meta.source_ip\ncapacity: 20\nleakspeed: 5s\nblackhole: 5m\ncache_size: 5\nlabels:\n  service: http\n  behavior: http:crawl\n  confidence: 2\n  spoofable: 0\n  label: Aomway shop filter enumeration\n  remediation: true\n",
