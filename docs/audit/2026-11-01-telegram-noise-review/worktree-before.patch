+    def invalidate(self, key=None):
+        with self._condition:
+            if key is None:
+                self._jobs.clear()
+            else:
+                self._jobs.pop(key, None)
+
+    def close(self):
+        with self._condition:
+            self._closed = True
+            self._jobs.clear()
+            self._condition.notify()
+        self._thread.join(timeout=40)
+
+    def _run(self):
+        while True:
+            with self._condition:
+                self._condition.wait_for(lambda: self._closed or self._jobs)
